// COMMON — V1 Prisma schema
// Source of truth for product rules: /01_V1_BUILD_PLAN.md (sections 2, 4, 6, 7)
//
// Cross-cutting invariants enforced by convention (see IMPLEMENTATION_PLAN.md for how
// the service layer upholds what the DB alone cannot):
// - A relationship's `confirmationStatus` only moves from SELF_DECLARED to
//   MUTUALLY_CONFIRMED via an explicit act of the *other* party — never a unilateral edit.
// - Endorsement/ProfessionalFeedback require a `relationshipId` establishing declared work
//   history; `status` stays UNVERIFIED unless that relationship is independently confirmed.
// - Visibility of a relationship is controlled per participant
//   (RelationshipParticipantVisibility), never globally by one side.
// - Exact location is never stored for display purposes — only city/region/country labels
//   plus a deliberately coarsened lat/lng for "local" radius search.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Auth (Auth.js / NextAuth v5 — Prisma adapter model shapes, extended)
// ============================================================================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole      @default(USER)
  status        AccountStatus @default(PENDING_VERIFICATION)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  accounts                Account[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  personProfile       PersonProfile?
  businessMemberships BusinessMembership[]
  ownedBusinesses     Business[]           @relation("BusinessOwner")

  skillSuggestions    Skill[]              @relation("SkillSuggestedBy")
  credentialClaims    CredentialClaim[]    @relation("ClaimSubject")
  verificationReviews VerificationReview[] @relation("ClaimReviewer")
  claimAppealsRaised  ClaimAppeal[]        @relation("ClaimAppealRaisedBy")
  badgeAwards         BadgeAward[]         @relation("BadgeRecipient")
  badgesIssued        BadgeAward[]         @relation("BadgeIssuer")

  relationshipsAsA              Relationship[]                      @relation("RelationshipPartyA")
  relationshipsAsB              Relationship[]                      @relation("RelationshipPartyB")
  relationshipsDeclared         Relationship[]                      @relation("RelationshipDeclaredBy")
  relationshipRequestsSent      RelationshipRequest[]               @relation("RelReqFrom")
  relationshipRequestsReceived  RelationshipRequest[]               @relation("RelReqTo")
  relationshipVisibilities      RelationshipParticipantVisibility[]
  relationshipEvidenceAdded     RelationshipEvidence[]
  relationshipDisputesRaised    RelationshipDispute[]
  relationshipProjectLinksAdded RelationshipProjectLink[]           @relation("ProjectLinkAddedBy")
  relationshipNetworkLinksAdded RelationshipNetworkLink[]           @relation("NetworkLinkAddedBy")

  businessRelationshipsAsAUser            BusinessRelationship[]                      @relation("BizRelPartyAUser")
  businessRelationshipsAsBUser            BusinessRelationship[]                      @relation("BizRelPartyBUser")
  businessRelationshipsDeclared           BusinessRelationship[]                      @relation("BizRelDeclaredBy")
  businessRelationshipVisibilitiesUpdated BusinessRelationshipParticipantVisibility[] @relation("BizRelVisibilityUpdatedBy")
  businessRelationshipEvidenceAdded       BusinessRelationshipEvidence[]              @relation("BizRelEvidenceAddedBy")
  businessRelationshipDisputesRaised      BusinessRelationshipDispute[]               @relation("BizRelDisputeRaisedBy")

  mentoringProgramsAsMentor MentoringProgram[] @relation("MentoringAsMentor")
  mentoringProgramsAsMentee MentoringProgram[] @relation("MentoringAsMentee")
  mentoringProgramsProposed MentoringProgram[] @relation("MentoringProposedBy")

  privateNetworksCreated    PrivateNetwork[]           @relation("PrivateNetworkCreatedBy")
  privateNetworkMemberships PrivateNetworkMembership[] @relation("PrivateNetworkMember")
  privateNetworkInvitesSent PrivateNetworkMembership[] @relation("PrivateNetworkInvitedBy")

  endorsementsGiven       Endorsement[]          @relation("EndorsementAuthor")
  endorsementsReceived    Endorsement[]          @relation("EndorsementSubject")
  feedbackGiven           ProfessionalFeedback[] @relation("FeedbackAuthor")
  feedbackReceived        ProfessionalFeedback[] @relation("FeedbackSubject")
  referencesGiven         Reference[]            @relation("ReferenceAuthor")
  referencesReceived      Reference[]            @relation("ReferenceSubject")
  referenceDisputesRaised ReferenceDispute[]     @relation("ReferenceDisputeRaisedBy")

  posts     Post[]
  comments  Comment[]
  reactions Reaction[]
  following Follow[]   @relation("Follower")
  followers Follow[]   @relation("Followee")

  helpRequests        HelpRequest[]
  helpResponses       HelpResponse[]
  opportunitiesPosted Opportunity[]
  applications        Application[]
  serviceOfferings    ServiceOffering[]
  inquiriesSent       Inquiry[]         @relation("InquiryFrom")

  mentoringOffers           MentoringOffer[]
  mentoringRequestsSent     MentoringRequest[]
  expertSessionsHosted      ExpertSession[]
  expertSessionBookings     ExpertSessionBooking[]
  learningCirclesCreated    LearningCircle[]
  learningCircleMemberships LearningCircleMembership[]

  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]

  notifications   Notification[]
  reportsFiled    Report[]       @relation("Reporter")
  reportsReceived Report[]       @relation("ReportTarget")
  reportsResolved Report[]       @relation("ReportResolver")
  blocksInitiated Block[]        @relation("Blocker")
  blocksReceived  Block[]        @relation("Blocked")
  auditEvents     AuditEvent[]   @relation("AuditActor")

  moderationFlagsSubject  ModerationFlag[]    @relation("FlagSubject")
  moderationFlagsReviewed ModerationFlag[]    @relation("FlagReviewer")
  reviewCasesSubject      ReviewCase[]        @relation("ReviewCaseSubject")
  reviewCasesAssigned     ReviewCase[]        @relation("ReviewCaseAssignee")
  safetyMetricEvents      SafetyMetricEvent[] @relation("SafetyMetricActor")
  apiKeys                 ApiKey[]
  aiFlagsReviewed         AiModerationFlag[]  @relation("AiFlagReviewer")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Identity: person profiles, businesses, skills
// ============================================================================

enum AvailabilityStatus {
  OPEN_TO_WORK
  OPEN_TO_COLLAB
  LIMITED
  NOT_AVAILABLE
}

model PersonProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  slug              String             @unique
  displayName       String
  bio               String?            @db.Text
  city              String?
  region            String?
  country           String?
  // Deliberately coarsened (rounded to ~city-block precision) — never exact address.
  approxLat         Float?
  approxLng         Float?
  languages         String[]
  availability      AvailabilityStatus @default(NOT_AVAILABLE)
  contactPreference Json? // e.g. { allowMessages: true, allowEmailContact: false }
  headlineSkillId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // Generated tsvector over displayName (weight A) + bio (weight B), maintained by
  // Postgres itself (GENERATED ALWAYS AS ... STORED — see the search-fulltext
  // migration). Prisma has no native tsvector type, hence Unsupported; the GIN index
  // below is declared so `prisma migrate dev` diffing doesn't try to drop what the
  // hand-written migration SQL created. Never written to from application code.
  searchVector Unsupported("tsvector")?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  personSkills      PersonSkill[]
  portfolioItems    PortfolioItem[]
  experienceEntries ExperienceEntry[]
  serviceOfferings  ServiceOffering[]

  @@index([city, region, country])
  @@index([searchVector], type: Gin)
  // Trigram indexes back similarity()-based fuzzy ranking/typo tolerance, separate
  // from the tsvector above (which handles word-level full-text relevance).
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([bio(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  city        String?
  region      String?
  country     String?
  approxLat   Float?
  approxLng   Float?
  ownerUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner               User                     @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  memberships         BusinessMembership[]
  portfolioItems      PortfolioItem[]
  serviceOfferings    ServiceOffering[]
  opportunitiesPosted Opportunity[]
  analyticsEvents     BusinessAnalyticsEvent[]

  businessRelationshipsAsA BusinessRelationship[] @relation("BizRelPartyABusiness")
  businessRelationshipsAsB BusinessRelationship[] @relation("BizRelPartyBBusiness")

  @@index([city, region, country])
}

enum BusinessMembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum BusinessMembershipStatus {
  PENDING
  CONFIRMED
  DISPUTED
  REMOVED
}

model BusinessMembership {
  id          String                   @id @default(cuid())
  businessId  String
  userId      String
  role        BusinessMembershipRole   @default(MEMBER)
  status      BusinessMembershipStatus @default(PENDING)
  claimedAt   DateTime                 @default(now())
  confirmedAt DateTime?

  // --- Verified membership tier (Track 6 — business tooling) ---------------------
  // Self-declared (PENDING) -> owner-confirmed (CONFIRMED) is the existing tier.
  // `verificationClaimId` adds a *third* tier on top of CONFIRMED: the member backs
  // their membership with a `CredentialClaim` (reusing the same admin-reviewed
  // claim/VerificationReview pipeline as every other claim type — see
  // data-model.md invariant #8) and an admin approval marks it verified.
  //
  // INTEGRATION POINT for Track 2 (Identity & evidence): that track's `Reference`
  // model/service (src/lib/services/reference-service.ts) is described as "a
  // confirmed-relationship-gated structured reference, a tier above endorsements."
  // That is a better-fitting backing primitive for "verified membership" than a
  // generic CredentialClaim, once it exists. When integrating, prefer swapping this
  // claim-based link for a Reference-based one (e.g. a membership verification
  // backed by a Reference from another confirmed business member/owner), or layer
  // both. This field and `requestMembershipVerification()` in business-service.ts
  // are the seam to replace/extend — not a parallel system to keep forever.
  verificationClaimId String?          @unique
  verificationClaim   CredentialClaim? @relation("MembershipVerificationClaim", fields: [verificationClaimId], references: [id])
  verifiedAt          DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

// ----------------------------------------------------------------------------------
// Business analytics (Track 6 — business tooling)
// ----------------------------------------------------------------------------------
// Deliberately minimal, aggregate-only event log — NOT reusing `AuditEvent` (that
// table is a safety/moderation audit trail with a different retention and access
// model). `viewerUserId` is stored only to let a future dedupe/rate-limit pass work;
// it is never surfaced per-viewer to the business owner — see business-service.ts
// `getBusinessAnalytics()` and the flagged policy question in docs/decisions.md
// about re-identification risk in business analytics.
enum BusinessAnalyticsEventType {
  STOREFRONT_VIEW
}

model BusinessAnalyticsEvent {
  id           String                     @id @default(cuid())
  businessId   String
  type         BusinessAnalyticsEventType
  viewerUserId String?
  createdAt    DateTime                   @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, type, createdAt])
}

enum SkillCategoryGroup {
  TRADES
  ARTS
  AGRICULTURE
  HEALTHCARE_ADJACENT
  TECHNOLOGY
  BUSINESS_PROFESSIONAL
  OTHER
}

model Skill {
  id            String             @id @default(cuid())
  slug          String             @unique
  name          String
  categoryGroup SkillCategoryGroup @default(OTHER)
  isApproved    Boolean            @default(true)
  suggestedById String?
  createdAt     DateTime           @default(now())

  suggestedBy          User?                 @relation("SkillSuggestedBy", fields: [suggestedById], references: [id])
  aliases              SkillAlias[]
  personSkills         PersonSkill[]
  portfolioItems       PortfolioItemSkill[]
  helpRequests         HelpRequest[]
  opportunities        Opportunity[]
  opportunityTeamSlots OpportunityTeamSlot[]
  serviceOfferings     ServiceOffering[]
  endorsements         Endorsement[]
  mentoringPrograms    MentoringProgram[]
  mentoringOffers      MentoringOffer[]
  expertSessions       ExpertSession[]
  learningCircles      LearningCircle[]

  @@index([categoryGroup])
  // Trigram index for fuzzy/typo-tolerant matching on skill names (search-fulltext
  // migration creates this with `gin_trgm_ops`; declared here so schema diffing
  // doesn't try to drop it).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model SkillAlias {
  id      String @id @default(cuid())
  skillId String
  alias   String
  locale  String @default("en")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([alias, locale])
  @@index([skillId])
  @@index([alias(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum ProfessionalStage {
  LEARNING
  EMERGING
  PRACTICING
  ESTABLISHED
}

model PersonSkill {
  id              String            @id @default(cuid())
  personProfileId String
  skillId         String
  isPrimary       Boolean           @default(false)
  stage           ProfessionalStage @default(LEARNING)
  stageRationale  Json? // criteria snapshot explaining the system-assigned stage
  stageUpdatedAt  DateTime?
  yearsPracticing Float?
  createdAt       DateTime          @default(now())

  personProfile PersonProfile @relation(fields: [personProfileId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id])

  @@unique([personProfileId, skillId])
  @@index([skillId, isPrimary])
}

// ============================================================================
// Portfolio & experience
// ============================================================================

enum Visibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

model PortfolioItem {
  id              String     @id @default(cuid())
  personProfileId String?
  businessId      String?
  title           String
  description     String?    @db.Text
  images          String[]
  tags            String[]
  links           Json?
  dateOccurred    DateTime?
  visibility      Visibility @default(PUBLIC)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  personProfile                PersonProfile?                 @relation(fields: [personProfileId], references: [id], onDelete: Cascade)
  business                     Business?                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  skills                       PortfolioItemSkill[]
  relationshipEvidence         RelationshipEvidence[]
  projectLinks                 RelationshipProjectLink[]
  businessRelationshipEvidence BusinessRelationshipEvidence[]

  @@index([personProfileId])
  @@index([businessId])
}

model PortfolioItemSkill {
  portfolioItemId String
  skillId         String

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id])

  @@id([portfolioItemId, skillId])
}

model ExperienceEntry {
  id               String    @id @default(cuid())
  personProfileId  String
  title            String
  organizationName String
  linkedBusinessId String?
  startDate        DateTime
  endDate          DateTime?
  description      String?   @db.Text
  createdAt        DateTime  @default(now())

  personProfile PersonProfile     @relation(fields: [personProfileId], references: [id], onDelete: Cascade)
  claims        CredentialClaim[]

  @@index([personProfileId])
}

// ============================================================================
// Claims, verification, badges
// ============================================================================

enum ClaimType {
  IDENTITY
  EXPERIENCE
  CREDENTIAL
  PROJECT_WORK
  COMPETENCY
}

enum ClaimStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  REVOKED
}

model CredentialClaim {
  id                  String      @id @default(cuid())
  subjectUserId       String
  claimType           ClaimType
  relatedExperienceId String?
  title               String
  description         String?     @db.Text
  evidenceUrls        String[]
  status              ClaimStatus @default(SUBMITTED)
  submittedAt         DateTime    @default(now())
  decidedAt           DateTime?
  // Track 2 (identity & evidence): time-bound claims (e.g. a credential that lapses)
  // can carry an expiry; null means "doesn't expire". Revocation already has a path via
  // ClaimStatus.REVOKED + a VerificationReview(decision: REVOKED) row, which already
  // carries the reviewer/notes/timestamp audit trail — these two fields just add the
  // same reason/when shape Badge already has for REVOKED, for callers that want to read
  // "why revoked" off the claim itself instead of joining to its latest review.
  revokedAt           DateTime?
  revokedReason       String?     @db.Text
  expiresAt           DateTime?

  subject     User                 @relation("ClaimSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  experience  ExperienceEntry?     @relation(fields: [relatedExperienceId], references: [id])
  reviews     VerificationReview[]
  badgeAwards BadgeAward[]
  appeals     ClaimAppeal[]
  // Back-relation for the verified-membership tier (Track 6) — see
  // BusinessMembership.verificationClaimId for the integration-point note re: Track 2.
  membershipVerificationFor BusinessMembership? @relation("MembershipVerificationClaim")

  @@index([subjectUserId, status])
}

/**
 * Appeals path for a claim decision the subject contests (typically after REJECTED or
 * REVOKED). Reuses `DisputeStatus` — same OPEN/UNDER_REVIEW/RESOLVED_UPHELD/
 * RESOLVED_REMOVED shape as RelationshipDispute and ReferenceDispute: an appeal is
 * structurally "a contest raised against a decision", same as those. Resolving an
 * appeal does NOT itself mutate CredentialClaim.status (mirrors resolveDispute's
 * existing behavior for relationships) — an admin who overturns an appeal re-reviews
 * the claim explicitly via the existing decideClaim path, so there is always a
 * VerificationReview row explaining any status change, never an implicit one from the
 * appeal alone. See docs/decisions.md for why this stays manual rather than automatic.
 */
model ClaimAppeal {
  id              String        @id @default(cuid())
  claimId         String
  raisedByUserId  String
  reason          String        @db.Text
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?       @db.Text
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  claim    CredentialClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  raisedBy User            @relation("ClaimAppealRaisedBy", fields: [raisedByUserId], references: [id])

  @@index([claimId])
}

enum ReviewDecision {
  APPROVED
  REJECTED
  REQUEST_MORE_INFO
  REVOKED
}

model VerificationReview {
  id             String         @id @default(cuid())
  claimId        String
  reviewerUserId String
  decision       ReviewDecision
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())

  claim    CredentialClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reviewer User            @relation("ClaimReviewer", fields: [reviewerUserId], references: [id])

  @@index([claimId])
}

enum BadgeKind {
  CLAIM_VERIFICATION
  FEEDBACK_ATTRIBUTE
  ACHIEVEMENT
}

model BadgeDefinition {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @db.Text
  kind        BadgeKind
  criteria    Json // e.g. { minConfirmedFeedback: 3, attribute: "reliability" }
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  awards BadgeAward[]
}

enum BadgeAwardStatus {
  ACTIVE
  REVOKED
}

model BadgeAward {
  id                String           @id @default(cuid())
  badgeDefinitionId String
  recipientUserId   String
  basisClaimId      String?
  basis             Json? // explains derivation, e.g. feedback aggregation refs
  issuerUserId      String? // null = system-awarded
  status            BadgeAwardStatus @default(ACTIVE)
  issuedAt          DateTime         @default(now())
  revokedAt         DateTime?
  revokedReason     String?
  // Track 2 (identity & evidence): time-bound badges (e.g. a feedback-derived
  // attribute that should lapse without fresh evidence) can carry an expiry; null
  // means "doesn't expire". Nothing currently flips status on expiry automatically —
  // see expireOverdueBadgeAwards() in badge-service.ts, which is an explicit call, not
  // a cron job (no scheduler infra exists in this app yet).
  expiresAt         DateTime?

  badgeDefinition BadgeDefinition  @relation(fields: [badgeDefinitionId], references: [id])
  recipient       User             @relation("BadgeRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  issuer          User?            @relation("BadgeIssuer", fields: [issuerUserId], references: [id])
  basisClaim      CredentialClaim? @relation(fields: [basisClaimId], references: [id])

  @@index([recipientUserId, status])
}

// ============================================================================
// Relationship graph
// ============================================================================

enum RelationshipType {
  WORKED_WITH
  COLLEAGUE
  COLLABORATOR
  CLIENT_PROVIDER
  MENTOR_MENTEE
  CONSULTANT_CLIENT
  BUSINESS_PARTNER
  FRIEND
  FAMILY
  LEARNING_FROM
}

enum RelationshipState {
  PROPOSED
  ACTIVE
  PAST
  PLANNED
}

enum ConfirmationStatus {
  SELF_DECLARED
  MUTUALLY_CONFIRMED
  EVIDENCE_REVIEWED
}

enum ConsentStatus {
  NOT_REQUIRED
  PENDING
  GRANTED
  DENIED
}

enum RelationshipIntent {
  WANT_TO_COLLABORATE
  SEEK_MENTORSHIP
  SEEK_CONSULTATION
  INTERESTED_IN_HIRING
  WANT_TO_LEARN
  SOCIALIZE
}

// partyA/partyB roles are free-text labels scoped per type (e.g. MENTOR_MENTEE ->
// "MENTOR"/"MENTEE"; CLIENT_PROVIDER -> "CLIENT"/"PROVIDER"; symmetric types like
// COLLEAGUE just repeat the type name on both sides). Validated in the service layer
// against a fixed role map per RelationshipType — not worth a DB enum per type.
model Relationship {
  id                 String             @id @default(cuid())
  type               RelationshipType
  partyAUserId       String
  partyARole         String
  partyBUserId       String
  partyBRole         String
  state              RelationshipState  @default(PROPOSED)
  confirmationStatus ConfirmationStatus @default(SELF_DECLARED)
  declaredByUserId   String
  // FAMILY relationships require the named counterpart's consent before the tie can be
  // shown publicly naming them — see plan section 4.C privacy exception.
  counterpartConsent ConsentStatus      @default(NOT_REQUIRED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  partyA     User @relation("RelationshipPartyA", fields: [partyAUserId], references: [id], onDelete: Cascade)
  partyB     User @relation("RelationshipPartyB", fields: [partyBUserId], references: [id], onDelete: Cascade)
  declaredBy User @relation("RelationshipDeclaredBy", fields: [declaredByUserId], references: [id])

  visibilities      RelationshipParticipantVisibility[]
  evidence          RelationshipEvidence[]
  disputes          RelationshipDispute[]
  endorsements      Endorsement[]
  feedback          ProfessionalFeedback[]
  references        Reference[]
  projectLinks      RelationshipProjectLink[]
  networkLinks      RelationshipNetworkLink[]
  mentoringPrograms MentoringProgram[]

  @@index([partyAUserId, type])
  @@index([partyBUserId, type])
}

enum RelationshipRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model RelationshipRequest {
  id                      String                    @id @default(cuid())
  fromUserId              String
  toUserId                String
  proposedType            RelationshipType
  intent                  RelationshipIntent
  message                 String?                   @db.Text
  status                  RelationshipRequestStatus @default(PENDING)
  createdAt               DateTime                  @default(now())
  respondedAt             DateTime?
  resultingRelationshipId String?

  from User @relation("RelReqFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("RelReqTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model RelationshipParticipantVisibility {
  relationshipId String
  userId         String
  visibility     Visibility @default(PUBLIC)
  hidden         Boolean    @default(false) // participant-specific hide, e.g. one-sided "learning from"
  updatedAt      DateTime   @updatedAt

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([relationshipId, userId])
}

model RelationshipEvidence {
  id              String   @id @default(cuid())
  relationshipId  String
  description     String   @db.Text
  portfolioItemId String?
  url             String?
  addedByUserId   String
  createdAt       DateTime @default(now())

  relationship  Relationship   @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  portfolioItem PortfolioItem? @relation(fields: [portfolioItemId], references: [id])
  addedBy       User           @relation(fields: [addedByUserId], references: [id])

  @@index([relationshipId])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_UPHELD
  RESOLVED_REMOVED
}

model RelationshipDispute {
  id              String        @id @default(cuid())
  relationshipId  String
  raisedByUserId  String
  reason          String        @db.Text
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?       @db.Text
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  raisedBy     User         @relation(fields: [raisedByUserId], references: [id])

  @@index([relationshipId])
}

enum EndorsementStatus {
  UNVERIFIED
  VERIFIED
}

model Endorsement {
  id             String            @id @default(cuid())
  endorserUserId String
  subjectUserId  String
  skillId        String
  relationshipId String
  status         EndorsementStatus @default(UNVERIFIED)
  comment        String?           @db.Text
  createdAt      DateTime          @default(now())

  endorser     User         @relation("EndorsementAuthor", fields: [endorserUserId], references: [id], onDelete: Cascade)
  subject      User         @relation("EndorsementSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id])
  relationship Relationship @relation(fields: [relationshipId], references: [id])

  @@unique([endorserUserId, subjectUserId, skillId])
  @@index([subjectUserId])
}

model ProfessionalFeedback {
  id                       String   @id @default(cuid())
  authorUserId             String
  subjectUserId            String
  relationshipId           String
  attributes               Json // e.g. { communication: 5, reliability: 4, timeManagement: 5 }
  comment                  String?  @db.Text
  isIndependentlyConfirmed Boolean  @default(false) // snapshot of relationship confirmation at write time
  createdAt                DateTime @default(now())

  author       User         @relation("FeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  subject      User         @relation("FeedbackSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  relationship Relationship @relation(fields: [relationshipId], references: [id])

  @@index([subjectUserId])
}

// ----------------------------------------------------------------------------
// Track 2 (identity & evidence, year 2 roadmap): a third evidence tier above
// self-claim (CredentialClaim) and admin-reviewed claim — a structured REFERENCE left
// by someone with a CONFIRMED relationship to the subject. Stronger gate than
// Endorsement/ProfessionalFeedback, which only require a *declared* (not necessarily
// confirmed) relationship — see createReference() in reference-service.ts.
// ----------------------------------------------------------------------------

enum ReferenceStatus {
  SUBMITTED
  DISPUTED
  REVOKED
}

model Reference {
  id             String          @id @default(cuid())
  authorUserId   String
  subjectUserId  String
  relationshipId String
  // Structured, scoped attributes — same shape convention as
  // ProfessionalFeedback.attributes (e.g. { communication: 5, reliability: 4 }), not
  // freeform-only text, per the track doc's "structured content" requirement.
  attributes     Json
  comment        String?         @db.Text
  status         ReferenceStatus @default(SUBMITTED)
  // Controlled by the SUBJECT only (reference-service.setReferenceVisibility enforces
  // this) — mirrors RelationshipParticipantVisibility's "each side controls their own
  // display" pattern, collapsed to one field since only the subject's profile ever
  // renders a Reference about them.
  visibility     Visibility      @default(PUBLIC)
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedReason  String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  author       User               @relation("ReferenceAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  subject      User               @relation("ReferenceSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  relationship Relationship       @relation(fields: [relationshipId], references: [id])
  disputes     ReferenceDispute[]

  // One reference per author/subject/relationship — an author can still leave a
  // separate reference anchored to a *different* confirmed relationship with the same
  // subject (e.g. worked together twice, years apart), matching the product's general
  // "multiple relationship types/instances between the same two people" stance.
  @@unique([authorUserId, subjectUserId, relationshipId])
  @@index([subjectUserId, status])
}

/**
 * The subject's path to contest a reference written about them — same contest shape
 * as RelationshipDispute/ClaimAppeal (reuses DisputeStatus). Resolving a dispute here
 * does NOT itself change Reference.status; an admin who finds the dispute valid uses
 * the separate, explicit revokeReference() action so there is always a direct
 * admin-attributable audit event for any status change, not an implicit one.
 */
model ReferenceDispute {
  id              String        @id @default(cuid())
  referenceId     String
  raisedByUserId  String
  reason          String        @db.Text
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?       @db.Text
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  reference Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  raisedBy  User      @relation("ReferenceDisputeRaisedBy", fields: [raisedByUserId], references: [id])

  @@index([referenceId])
}

// ============================================================================
// Relationship graph extensions (Track 3 — relationships & collaboration graph):
// project/team-history anchoring, business-to-person & business-to-business
// relationships, structured mentoring programs, optional private networks.
//
// These extend, not replace, the person-to-person Relationship model above — see
// docs/roadmap/03-relationships-and-collaboration.md and the "Documented deviations"
// entry in docs/decisions.md for what's deliberately conservative here (e.g. no new
// consent gate beyond FAMILY; private-network membership defaults to not publicly
// visible) pending an explicit product-policy decision.
// ============================================================================

// --- Project / team-history anchoring ---------------------------------------
//
// Ties an existing person-to-person Relationship to a specific PortfolioItem
// ("worked-with" -> "worked with on *this*"). A relationship can be anchored to
// multiple projects over time; a project can have many anchors, which is what makes
// "who worked together on this project" queryable (see team-history-service.ts).

model RelationshipProjectLink {
  id              String   @id @default(cuid())
  relationshipId  String
  portfolioItemId String
  note            String?  @db.Text // e.g. "led the finishing work on this piece"
  addedByUserId   String
  createdAt       DateTime @default(now())

  relationship  Relationship  @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  addedBy       User          @relation("ProjectLinkAddedBy", fields: [addedByUserId], references: [id])

  @@unique([relationshipId, portfolioItemId])
  @@index([portfolioItemId])
}

// --- Business-to-person & business-to-business relationships ----------------
//
// Deliberately a separate table from Relationship rather than widening that table's
// party columns: it reuses the same RelationshipState/ConfirmationStatus/Visibility/
// DisputeStatus enums and the same self-declared -> mutually-confirmed,
// per-side-visibility, disputable shape, without risking the person-to-person
// Relationship table's existing invariants/tests. Exactly one of
// {partyAUserId, partyABusinessId} (matching partyAType) must be set per side —
// the DB doesn't enforce that (same convention as PersonSkill.isPrimary); see
// business-relationship-service.ts.
enum BusinessRelationshipPartyKind {
  PERSON
  BUSINESS
}

enum BusinessRelationshipType {
  ENGAGEMENT // a business formally engages a person (contractor, staff-for-hire, etc.)
  ENDORSEMENT // a business endorses a person's work
  CLIENT_PROVIDER // either side may be the client or the provider
  COLLABORATOR // joint work, business-to-business or business-to-person
  PARTNERSHIP // formal business-to-business partnership
}

enum PartySide {
  A
  B
}

model BusinessRelationship {
  id                 String                        @id @default(cuid())
  type               BusinessRelationshipType
  partyAType         BusinessRelationshipPartyKind
  partyAUserId       String?
  partyABusinessId   String?
  partyARole         String
  partyBType         BusinessRelationshipPartyKind
  partyBUserId       String?
  partyBBusinessId   String?
  partyBRole         String
  state              RelationshipState             @default(PROPOSED)
  confirmationStatus ConfirmationStatus            @default(SELF_DECLARED)
  // Always a user: whoever declared this acted on behalf of their side (themselves, or
  // as an owner/confirmed admin of the business on that side).
  declaredByUserId   String
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  partyAUser     User?     @relation("BizRelPartyAUser", fields: [partyAUserId], references: [id])
  partyABusiness Business? @relation("BizRelPartyABusiness", fields: [partyABusinessId], references: [id])
  partyBUser     User?     @relation("BizRelPartyBUser", fields: [partyBUserId], references: [id])
  partyBBusiness Business? @relation("BizRelPartyBBusiness", fields: [partyBBusinessId], references: [id])
  declaredBy     User      @relation("BizRelDeclaredBy", fields: [declaredByUserId], references: [id])

  visibilities BusinessRelationshipParticipantVisibility[]
  evidence     BusinessRelationshipEvidence[]
  disputes     BusinessRelationshipDispute[]

  @@index([partyAUserId])
  @@index([partyABusinessId])
  @@index([partyBUserId])
  @@index([partyBBusinessId])
}

// One row per side (A/B), not per user — the "participant" on a business side is
// whoever is currently authorized to act for that business, not a fixed individual.
model BusinessRelationshipParticipantVisibility {
  businessRelationshipId String
  side                   PartySide
  visibility             Visibility @default(PUBLIC)
  hidden                 Boolean    @default(false)
  updatedByUserId        String
  updatedAt              DateTime   @updatedAt

  businessRelationship BusinessRelationship @relation(fields: [businessRelationshipId], references: [id], onDelete: Cascade)
  updatedBy            User                 @relation("BizRelVisibilityUpdatedBy", fields: [updatedByUserId], references: [id])

  @@id([businessRelationshipId, side])
}

model BusinessRelationshipEvidence {
  id                     String   @id @default(cuid())
  businessRelationshipId String
  description            String   @db.Text
  portfolioItemId        String?
  url                    String?
  addedByUserId          String
  createdAt              DateTime @default(now())

  businessRelationship BusinessRelationship @relation(fields: [businessRelationshipId], references: [id], onDelete: Cascade)
  portfolioItem        PortfolioItem?       @relation(fields: [portfolioItemId], references: [id])
  addedBy              User                 @relation("BizRelEvidenceAddedBy", fields: [addedByUserId], references: [id])

  @@index([businessRelationshipId])
}

model BusinessRelationshipDispute {
  id                     String        @id @default(cuid())
  businessRelationshipId String
  raisedByUserId         String
  reason                 String        @db.Text
  status                 DisputeStatus @default(OPEN)
  resolutionNotes        String?       @db.Text
  createdAt              DateTime      @default(now())
  resolvedAt             DateTime?

  businessRelationship BusinessRelationship @relation(fields: [businessRelationshipId], references: [id], onDelete: Cascade)
  raisedBy             User                 @relation("BizRelDisputeRaisedBy", fields: [raisedByUserId], references: [id])

  @@index([businessRelationshipId])
}

// --- Structured mentoring programs -------------------------------------------
//
// Distinct from both the generic MENTOR_MENTEE Relationship type and the one-sided
// LEARNING_FROM declaration: a program is a mutual proposal with its own lifecycle
// (PROPOSED -> ACTIVE -> COMPLETED/DECLINED/CANCELLED). It deliberately does NOT
// auto-create or auto-confirm a Relationship row on acceptance — that would be a
// second, looser path to "mutually confirmed" and would blur the one load-bearing
// invariant in the whole app (see docs/data-model.md invariant #1). `relationshipId`
// is an optional cross-link for when the two people separately also hold a confirmed
// MENTOR_MENTEE Relationship they want this program associated with.
enum MentoringProgramStatus {
  PROPOSED
  ACTIVE
  DECLINED
  COMPLETED
  CANCELLED
}

model MentoringProgram {
  id               String                 @id @default(cuid())
  mentorUserId     String
  menteeUserId     String
  proposedByUserId String
  title            String
  description      String?                @db.Text
  focusSkillId     String?
  goals            Json? // optional free-form milestone/goal list, shape owned by the caller
  status           MentoringProgramStatus @default(PROPOSED)
  relationshipId   String?
  startDate        DateTime?
  endDate          DateTime?
  respondedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  mentor       User          @relation("MentoringAsMentor", fields: [mentorUserId], references: [id], onDelete: Cascade)
  mentee       User          @relation("MentoringAsMentee", fields: [menteeUserId], references: [id], onDelete: Cascade)
  proposedBy   User          @relation("MentoringProposedBy", fields: [proposedByUserId], references: [id])
  focusSkill   Skill?        @relation(fields: [focusSkillId], references: [id])
  relationship Relationship? @relation(fields: [relationshipId], references: [id])

  @@index([mentorUserId, status])
  @@index([menteeUserId, status])
}

// --- Optional private networks -----------------------------------------------
//
// A closed group whose members can see relationships tagged into it even when that
// visibility is narrower than what the relationship's own per-participant visibility
// would otherwise allow a stranger to see. This layers ON TOP of (never replaces)
// RelationshipParticipantVisibility: a relationship hidden by either participant stays
// hidden from everyone, network membership or not — see canViewWithNetworkScope() in
// private-network-service.ts. `membershipVisible` (is the member list itself visible
// to non-members?) defaults to false/members-only as the conservative, reversible
// choice — see docs/decisions.md, this is a flagged policy question, not a settled one.
enum PrivateNetworkMembershipRole {
  ADMIN
  MEMBER
}

enum PrivateNetworkMembershipStatus {
  INVITED
  ACTIVE
  REMOVED
  DECLINED
}

model PrivateNetwork {
  id                String   @id @default(cuid())
  name              String
  description       String?  @db.Text
  createdByUserId   String
  membershipVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy         User                       @relation("PrivateNetworkCreatedBy", fields: [createdByUserId], references: [id])
  memberships       PrivateNetworkMembership[]
  relationshipLinks RelationshipNetworkLink[]

  @@index([createdByUserId])
}

model PrivateNetworkMembership {
  id              String                         @id @default(cuid())
  networkId       String
  userId          String
  role            PrivateNetworkMembershipRole   @default(MEMBER)
  status          PrivateNetworkMembershipStatus @default(INVITED)
  invitedByUserId String
  joinedAt        DateTime?
  createdAt       DateTime                       @default(now())

  network   PrivateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  user      User           @relation("PrivateNetworkMember", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User           @relation("PrivateNetworkInvitedBy", fields: [invitedByUserId], references: [id])

  @@unique([networkId, userId])
  @@index([userId, status])
}

model RelationshipNetworkLink {
  relationshipId String
  networkId      String
  addedByUserId  String
  createdAt      DateTime @default(now())

  relationship Relationship   @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  network      PrivateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)
  addedBy      User           @relation("NetworkLinkAddedBy", fields: [addedByUserId], references: [id])

  @@id([relationshipId, networkId])
}

// ============================================================================
// Social feed
// ============================================================================

model Post {
  id                    String     @id @default(cuid())
  authorUserId          String
  content               String     @db.Text
  images                String[]
  linkedPortfolioItemId String?
  visibility            Visibility @default(PUBLIC)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  author    User       @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  @@index([authorUserId])
}

model Comment {
  id           String    @id @default(cuid())
  postId       String
  authorUserId String
  content      String    @db.Text
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([postId])
}

enum ReactionType {
  LIKE
  APPLAUD
  INSIGHTFUL
}

model Reaction {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Follow {
  id             String   @id @default(cuid())
  followerUserId String
  followeeUserId String
  createdAt      DateTime @default(now())

  follower User @relation("Follower", fields: [followerUserId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeUserId], references: [id], onDelete: Cascade)

  @@unique([followerUserId, followeeUserId])
}

// ============================================================================
// Opportunity layer: help requests, jobs/gigs, services
// ============================================================================

enum GeoScope {
  LOCAL
  REGION
  GLOBAL
}

enum HelpRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model HelpRequest {
  id           String            @id @default(cuid())
  authorUserId String
  title        String
  description  String            @db.Text
  skillId      String?
  geoScope     GeoScope          @default(LOCAL)
  status       HelpRequestStatus @default(OPEN)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  author    User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  skill     Skill?         @relation(fields: [skillId], references: [id])
  responses HelpResponse[]

  @@index([status, geoScope])
}

enum HelpResponseStatus {
  SUBMITTED
  SHORTLISTED
  DECLINED
  ACCEPTED
}

model HelpResponse {
  id              String             @id @default(cuid())
  helpRequestId   String
  responderUserId String
  message         String             @db.Text
  status          HelpResponseStatus @default(SUBMITTED)
  createdAt       DateTime           @default(now())

  helpRequest HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  responder   User        @relation(fields: [responderUserId], references: [id], onDelete: Cascade)

  @@index([helpRequestId])
}

enum OpportunityType {
  TASK
  CONTRACT
  FULL_TIME
}

enum LocationType {
  ONSITE
  REMOTE
  HYBRID
}

enum OpportunityStatus {
  OPEN
  CLOSED
}

// Track 4 (opportunity network): a discriminator on the existing Opportunity shape
// rather than a parallel model, per docs/roadmap/04-opportunity-network.md's own
// guidance to check that first. All new fields below are optional/defaulted so
// existing STANDARD rows (V1's task/contract/full-time opportunities) are unaffected.
enum OpportunityKind {
  STANDARD
  MICROTASK
  APPRENTICESHIP
  TEAM_PROJECT
}

model Opportunity {
  id             String            @id @default(cuid())
  postedByUserId String
  businessId     String?
  type           OpportunityType
  kind           OpportunityKind   @default(STANDARD)
  title          String
  description    String            @db.Text
  skillId        String?
  locationType   LocationType      @default(REMOTE)
  geoScope       GeoScope          @default(LOCAL)
  status         OpportunityStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // MICROTASK fields — short, bounded, optionally-recurring work. No budget/price
  // field by design: payments/escrow stay out of scope for this track (see roadmap doc).
  estimatedHours Int?
  isRecurring    Boolean @default(false)
  recurrenceNote String?

  // APPRENTICESHIP fields — structured duration + a free-text focus area.
  // NOT WIRED: docs/roadmap/04-opportunity-network.md expects this to reference
  // Track 3's project/team-history anchoring (`RelationshipProjectLink` model,
  // `listTeamHistoryForProject`/`listVisibleTeamHistoryForProject` in
  // team-history-service.ts) and likely Track 5's mentoring construct. Neither exists
  // in this worktree (both tracks are on separate branches). `mentorshipFocus` is a
  // deliberately plain free-text stand-in — do not treat it as the real integration;
  // a human integrator should replace/augment it with an actual link to those once
  // merged. See final build report / docs/decisions.md for the flagged gap.
  durationWeeks   Int?
  mentorshipFocus String? @db.Text

  postedBy     User                  @relation(fields: [postedByUserId], references: [id], onDelete: Cascade)
  business     Business?             @relation(fields: [businessId], references: [id])
  skill        Skill?                @relation(fields: [skillId], references: [id])
  applications Application[]
  teamSlots    OpportunityTeamSlot[]

  @@index([status, type, geoScope])
  @@index([kind])
}

// TEAM_PROJECT only: "need N people with skills X, Y for project Z" — a roster of
// open roles distinct from a single-hire Opportunity. Applicants apply to a specific
// slot (Application.teamSlotId); the poster assembles the team by accepting
// applications per slot. No stored "filled" counter — filled headcount is always
// derived by counting ACCEPTED applications for the slot, same philosophy as the rest
// of this schema (no redundant state to drift out of sync).
model OpportunityTeamSlot {
  id              String   @id @default(cuid())
  opportunityId   String
  roleTitle       String
  skillId         String?
  headcountNeeded Int      @default(1)
  createdAt       DateTime @default(now())

  opportunity  Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill        Skill?        @relation(fields: [skillId], references: [id])
  applications Application[]

  @@index([opportunityId])
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  REJECTED
  ACCEPTED
}

model Application {
  id              String            @id @default(cuid())
  opportunityId   String
  applicantUserId String
  teamSlotId      String?
  coverMessage    String?           @db.Text
  status          ApplicationStatus @default(SUBMITTED)
  createdAt       DateTime          @default(now())

  opportunity Opportunity          @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicant   User                 @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  teamSlot    OpportunityTeamSlot? @relation(fields: [teamSlotId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, applicantUserId, teamSlotId])
  @@index([teamSlotId])
}

model ServiceOffering {
  id              String   @id @default(cuid())
  personProfileId String?
  businessId      String?
  title           String
  description     String   @db.Text
  skillId         String?
  priceNote       String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  personProfile PersonProfile? @relation(fields: [personProfileId], references: [id], onDelete: Cascade)
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  skill         Skill?         @relation(fields: [skillId], references: [id])
  inquiries     Inquiry[]
  user          User?          @relation(fields: [userId], references: [id])
  userId        String?

  @@index([personProfileId])
  @@index([businessId])
}

enum InquiryStatus {
  SUBMITTED
  RESPONDED
  CLOSED
}

model Inquiry {
  id                String        @id @default(cuid())
  serviceOfferingId String
  inquirerUserId    String
  message           String        @db.Text
  status            InquiryStatus @default(SUBMITTED)
  createdAt         DateTime      @default(now())

  serviceOffering ServiceOffering @relation(fields: [serviceOfferingId], references: [id], onDelete: Cascade)
  inquirer        User            @relation("InquiryFrom", fields: [inquirerUserId], references: [id], onDelete: Cascade)

  @@index([serviceOfferingId])
}

// ============================================================================
// Messaging & notifications
// ============================================================================

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum NotificationType {
  RELATIONSHIP_REQUEST
  RELATIONSHIP_CONFIRMED
  RELATIONSHIP_DISPUTED
  ENDORSEMENT_RECEIVED
  FEEDBACK_RECEIVED
  CLAIM_DECISION
  BADGE_AWARDED
  POST_COMMENT
  POST_REACTION
  NEW_FOLLOWER
  HELP_RESPONSE
  APPLICATION_UPDATE
  INQUIRY_RECEIVED
  NEW_MESSAGE
  MODERATION_UPDATE
  MENTORING_REQUEST_RECEIVED
  MENTORING_REQUEST_DECISION
  EXPERT_SESSION_BOOKED
  EXPERT_SESSION_CANCELLED
  LEARNING_CIRCLE_JOIN_REQUEST
  LEARNING_CIRCLE_MEMBERSHIP_DECISION
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ============================================================================
// Safety & operations
// ============================================================================

enum ReportTargetType {
  USER
  POST
  COMMENT
  MESSAGE
  RELATIONSHIP
  BUSINESS
  PORTFOLIO_ITEM
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

model Report {
  id               String           @id @default(cuid())
  reporterUserId   String
  targetType       ReportTargetType
  targetId         String
  targetUserId     String? // denormalized when the target resolves to a user, for queueing
  reason           String
  details          String?          @db.Text
  status           ReportStatus     @default(OPEN)
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?

  reporter   User  @relation("Reporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetUser User? @relation("ReportTarget", fields: [targetUserId], references: [id])
  resolvedBy User? @relation("ReportResolver", fields: [resolvedByUserId], references: [id])

  @@index([status])
}

model Block {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockerUserId, blockedUserId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ============================================================================
// Learning & mentorship (Track 5)
//
// Three constructs, deliberately kept distinct per docs/roadmap/05-learning-and-mentorship.md:
// - MentoringOffer/MentoringRequest: a *mutual* mentoring marketplace. This is NOT a
//   replacement for the existing one-sided `LEARNING_FROM` relationship declaration,
//   which stays exactly as-is (self-declared, author-hideable, never implying agreement).
// - ExpertSession/ExpertSessionBooking: bookable, time-boxed sessions. No payment
//   processing — booking is just a capacity-checked reservation.
// - LearningCircle/LearningCircleMembership: a small-group construct, self-contained
//   rather than reusing Track 3's (Relationships & collaboration graph) private-network
//   scoping, which doesn't exist yet in this build — see docs/decisions.md.
//
// Accepting a MentoringRequest reuses the existing Relationship/RelationshipRequest
// machinery (relationship-service.ts) to create an actual MENTOR_MENTEE relationship,
// rather than inventing a parallel notion of "connected" — see mentoring-service.ts.
// ============================================================================

enum MentoringFormat {
  ONE_ON_ONE
  GROUP
  EITHER
}

enum MentoringRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

// A person's discoverable declaration that they're available to mentor on a given
// skill — the mutual counterpart to the one-sided LEARNING_FROM relationship. Any
// professional stage may post one; the UI must not frame higher stages as inherently
// more worthy mentors (see docs/roadmap/05-learning-and-mentorship.md "invariants").
model MentoringOffer {
  id           String          @id @default(cuid())
  mentorUserId String
  skillId      String
  title        String
  description  String          @db.Text
  format       MentoringFormat @default(ONE_ON_ONE)
  // Max concurrent mentees this offer will take on (across ACCEPTED requests).
  capacity     Int             @default(1)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  mentor   User               @relation(fields: [mentorUserId], references: [id], onDelete: Cascade)
  skill    Skill              @relation(fields: [skillId], references: [id])
  requests MentoringRequest[]
  sessions ExpertSession[]

  @@index([skillId, isActive])
  @@index([mentorUserId])
}

// A mentee's request to engage with a specific MentoringOffer. PENDING -> ACCEPTED
// creates a real Relationship (see mentoring-service.ts#acceptMentoringRequest);
// `resultingRelationshipId` is a plain denormalized pointer (no FK), matching the same
// pattern RelationshipRequest.resultingRelationshipId already uses.
model MentoringRequest {
  id                    String                  @id @default(cuid())
  offerId               String
  menteeUserId          String
  message               String?                 @db.Text
  status                MentoringRequestStatus  @default(PENDING)
  resultingRelationshipId String?
  createdAt             DateTime                @default(now())
  respondedAt           DateTime?

  offer  MentoringOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  mentee User           @relation(fields: [menteeUserId], references: [id], onDelete: Cascade)

  @@index([offerId, status])
  @@index([menteeUserId])
}

enum ExpertSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ExpertSessionBookingStatus {
  BOOKED
  CANCELLED
  ATTENDED
  NO_SHOW
}

// A bookable, time-boxed session hosted by a mentor/expert. Independent of
// PersonProfile.availability (a coarse status flag, not a schedule) — see the
// "policy question to flag" entry in docs/decisions.md.
model ExpertSession {
  id               String               @id @default(cuid())
  hostUserId       String
  mentoringOfferId String?
  skillId          String?
  title            String
  description      String?              @db.Text
  startsAt         DateTime
  endsAt           DateTime
  capacity         Int                  @default(1)
  status           ExpertSessionStatus  @default(SCHEDULED)
  locationType     LocationType         @default(REMOTE)
  geoScope         GeoScope             @default(GLOBAL)
  // Free-text note (e.g. "video link sent on booking") — never an exact address, same
  // discipline as every other free-text field in the app; there is no structured
  // precise-location field here to begin with.
  locationNote     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  host           User                   @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  mentoringOffer MentoringOffer?        @relation(fields: [mentoringOfferId], references: [id])
  skill          Skill?                 @relation(fields: [skillId], references: [id])
  bookings       ExpertSessionBooking[]

  @@index([skillId, status, startsAt])
  @@index([hostUserId])
}

model ExpertSessionBooking {
  id             String                      @id @default(cuid())
  sessionId      String
  attendeeUserId String
  status         ExpertSessionBookingStatus  @default(BOOKED)
  createdAt      DateTime                    @default(now())
  cancelledAt    DateTime?

  session  ExpertSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendee User          @relation(fields: [attendeeUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, attendeeUserId])
  @@index([sessionId, status])
  @@index([attendeeUserId])
}

enum LearningCircleMembershipRole {
  ORGANIZER
  MEMBER
}

enum LearningCircleMembershipStatus {
  PENDING
  ACTIVE
  LEFT
  REMOVED
}

// Small-group learning construct. Deliberately self-contained (its own membership
// model) rather than reusing Track 3's private-network scoping — that track is being
// built concurrently and doesn't exist in this codebase yet. Flagged for reconciliation
// during integration; see docs/decisions.md.
model LearningCircle {
  id            String   @id @default(cuid())
  creatorUserId String
  title         String
  description   String?  @db.Text
  skillId       String?
  capacity      Int      @default(8)
  geoScope      GeoScope @default(LOCAL)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator     User                       @relation(fields: [creatorUserId], references: [id], onDelete: Cascade)
  skill       Skill?                     @relation(fields: [skillId], references: [id])
  memberships LearningCircleMembership[]

  @@index([skillId, geoScope, isActive])
  @@index([creatorUserId])
}

model LearningCircleMembership {
  id        String                          @id @default(cuid())
  circleId  String
  userId    String
  role      LearningCircleMembershipRole    @default(MEMBER)
  status    LearningCircleMembershipStatus  @default(PENDING)
  joinedAt  DateTime                        @default(now())

  circle LearningCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([circleId, status])
}

// ============================================================================
// Trust & safety at scale (Track 9 — see docs/roadmap/09-trust-safety-and-moderation.md)
//
// These three models are deliberately generic so every other track's own
// dispute/claim/evidence models can plug into these queues without this schema
// needing to change when they merge:
//
//   - Track 2 (Identity & evidence) built `Reference`/`ReferenceDispute`/
//     `ClaimAppeal` on its own branch.
//   - Track 3 (Relationships) built `BusinessRelationship`/`MentoringProgram`/
//     `PrivateNetwork`, each with its own Dispute/Evidence sub-models, on its own
//     branch.
//   - Track 4 (Opportunity network) and Track 8 (AI assistance's fraud-flagging)
//     haven't landed yet but are named as future producers into this queue.
//
// The mechanism: every pointer from these models into "the substantive thing being
// reviewed/flagged" is a free-text (entityType, entityId) pair — exactly the
// pattern `AuditEvent` already uses above — never a Prisma relation to a specific
// model. That means a detector or admin action can reference a `Relationship`, a
// `CredentialClaim`, or (once merged) a Track 2 `ReferenceDispute` or a Track 3
// `BusinessRelationshipDispute` without this file ever needing a migration for it.
// Only pointers at `User` (a model guaranteed to exist here) are real relations.
//
// Integration note for whoever wires the other 8 tracks together: once Track 2's
// `ReferenceDispute`/`ClaimAppeal` and Track 3's dispute sub-models land, they do
// NOT need to be folded into `RelationshipDispute` or `CredentialClaim` — they can
// keep their own substantive status field (approved/rejected, upheld/removed, etc.)
// exactly like `RelationshipDispute.status` and `CredentialClaim.status` do today.
// Each just needs one `ReviewCase` row opened against it (`entityType` = e.g.
// `"REFERENCE_DISPUTE"`, `entityId` = that row's id) to get SLA/tier/assignment
// tracking for free, and its create/resolve service calls should call
// `recordSafetyMetricEvent()` (src/lib/services/safety-metrics-service.ts) the same
// way `relationship-service.ts#raiseDispute` and
// `admin-dispute-service.ts#resolveDispute` do, so it shows up in the same
// dispute-resolution-time/complaint-rate metrics instead of a parallel one.
// ============================================================================

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ModerationFlagStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  DISMISSED
}

// A system/detector-raised signal of a possible abuse pattern (endorsement rings,
// rapid mutual-confirmation churn, etc.) — distinct from `Report`, which is a human
// filing a complaint. Flags are advisory only: nothing in this track auto-actions
// against a user. A human triages each flag via `moderation-flag-service.ts`,
// either dismissing it or escalating it into a `ReviewCase` for formal review.
//
// Known `entityType` values as of this track's build: `"USER"`, `"RELATIONSHIP"`,
// `"ENDORSEMENT"`, `"ENDORSEMENT_CLUSTER"` (a synthetic id the detector mints for a
// group of relationships/endorsements it flagged together — not a real row id).
// `patternType` is likewise free text (e.g. `"RECIPROCAL_ENDORSEMENT_NO_EVIDENCE"`)
// rather than a closed enum, because the actual taxonomy of abuse patterns worth
// flagging is a product/policy call this track does not make — see this track's
// final report for what's flagged explicitly.
model ModerationFlag {
  id               String               @id @default(cuid())
  entityType       String
  entityId         String
  subjectUserId    String?
  patternType      String
  severity         FlagSeverity         @default(MEDIUM)
  detectorId       String // e.g. "endorsement-ring-detector@v1" — which detector/version raised it
  evidence         Json // the signal data backing the flag: involved ids, counts, scores
  status           ModerationFlagStatus @default(OPEN)
  createdAt        DateTime             @default(now())
  reviewedAt        DateTime?
  reviewedByUserId String?

  subject    User? @relation("FlagSubject", fields: [subjectUserId], references: [id])
  reviewedBy User? @relation("FlagReviewer", fields: [reviewedByUserId], references: [id])

  @@index([status])
  @@index([entityType, entityId])
  @@index([subjectUserId])
}

enum ReviewCaseType {
  VERIFICATION
  DISPUTE
  ABUSE_FLAG
}

enum ReviewTier {
  QUICK_PATH
  DEEP_REVIEW
}

enum ReviewPriority {
  NORMAL
  HIGH
  URGENT
}

enum ReviewCaseStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

// The generic workflow envelope — tier, SLA, assignment, and status — for any
// reviewable or disputable record, independent of who owns that record's
// substantive decision. `entityType`/`entityId` points at the thing actually being
// reviewed (a `CredentialClaim`, a `RelationshipDispute`, a `ModerationFlag`, or —
// once merged — a Track 2/3 model) using the same free-text-pointer convention as
// `AuditEvent`. This table intentionally holds NO Prisma relation to any of those
// models, so it never needs a migration when another track's dispute/claim model
// lands; see the block comment above this section for the integration contract.
//
// The substantive outcome (approved/rejected, upheld/removed) stays owned by that
// record's own model/service — this table only tracks how the queue is working the
// case, denormalizing `outcome` as a short free-text summary once that record
// resolves, purely for the metrics in `safety-metrics-service.ts`.
//
// Known `entityType` values as of this track's build: `"CREDENTIAL_CLAIM"`,
// `"RELATIONSHIP_DISPUTE"`, `"MODERATION_FLAG"`. Extend freely — e.g.
// `"REFERENCE_DISPUTE"`, `"CLAIM_APPEAL"`, `"BUSINESS_RELATIONSHIP_DISPUTE"`.
model ReviewCase {
  id               String           @id @default(cuid())
  caseType         ReviewCaseType
  entityType       String
  entityId         String
  subjectUserId    String?
  tier             ReviewTier?
  priority         ReviewPriority   @default(NORMAL)
  status           ReviewCaseStatus @default(OPEN)
  assignedToUserId String?
  openedAt         DateTime         @default(now())
  slaDueAt         DateTime?
  firstActionAt    DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  outcome          String?
  notes            String?          @db.Text

  subject    User? @relation("ReviewCaseSubject", fields: [subjectUserId], references: [id])
  assignedTo User? @relation("ReviewCaseAssignee", fields: [assignedToUserId], references: [id])

  @@unique([caseType, entityType, entityId])
  @@index([status])
  @@index([entityType, entityId])
  @@index([assignedToUserId, status])
}

// Append-only event log instrumenting the roadmap's named safety metrics —
// complaint rate, dispute resolution time, false verification rate, privacy
// incidents (see docs/roadmap/09-trust-safety-and-moderation.md). `metricType` is
// free text, not a closed enum, because which metrics matter and at what
// granularity is still an open product question — see `safety-metrics-service.ts`
// and this track's final report for what's instrumented today (complaint rate,
// dispute resolution time, flag volume/confirmation rate) versus what's a
// placeholder pending another track's data (a real "false verification rate" needs
// Track 2's `ClaimAppeal`, which hasn't merged into this schema yet).
model SafetyMetricEvent {
  id          String   @id @default(cuid())
  metricType  String
  entityType  String?
  entityId    String?
  actorUserId String?
  occurredAt  DateTime @default(now())
  durationMs  Int?
  value       Float?
  metadata    Json?

  actor User? @relation("SafetyMetricActor", fields: [actorUserId], references: [id])

  @@index([metricType, occurredAt])
  @@index([entityType, entityId])
}

// ============================================================================
// Platform & API (Track 7 — scoped API keys for non-browser clients)
// ============================================================================
//
// Conservative-by-design: an ApiKey is always tied to exactly one User (the same
// account a browser session would authenticate as) and carries an explicit, narrow
// `scopes` list the key's owner chose at creation time — never a broad bearer token
// that grants everything the user could do. Keys are minted by the user themselves
// from an authenticated web session (see /settings/api-keys), not through a separate
// credential-issuing flow, so there is exactly one place a password ever gets checked.
// `requireApiUser()` (src/lib/auth-helpers.ts) enforces the requested scope is a subset
// of the key's scopes before resolving the underlying user — the API surface then runs
// the identical service-layer calls a session-authenticated request would, so it can
// never bypass confirmation/visibility/claim-review invariants enforced there.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyPrefix  String // first few chars of the plaintext token, shown in the UI so a user can tell keys apart; never enough to guess the rest
  keyHash    String    @unique // sha256 of the full plaintext token; the plaintext itself is never stored
  scopes     String[] // subset of API_SCOPES (src/lib/services/api-key-service.ts); validated at creation, not DB-enforced
  lastUsedAt DateTime?
  expiresAt  DateTime? // nullable but createApiKey() always sets a default (90 days) unless the caller opts into a longer bound
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// Localization groundwork (Track 7) — extends the SkillAlias.locale pattern to
// other enum-backed display labels (professional stage names, skill category group
// names, ...) that today are hardcoded Record<string,string> maps in page components.
// This is plumbing only: V1 ships `en` rows equivalent to today's hardcoded labels,
// not translation coverage. See docs/localization.md.
// ============================================================================

model LocalizedLabel {
  id     String @id @default(cuid())
  domain String // e.g. "PROFESSIONAL_STAGE", "SKILL_CATEGORY_GROUP" — matches a Prisma enum name by convention, not enforced
  key    String // the enum value, e.g. "LEARNING", "TRADES"
  locale String @default("en")
  label  String

  @@unique([domain, key, locale])
  @@index([domain, locale])
}

// ============================================================================
// AI assistance (Track 8) — see docs/roadmap/08-ai-assistance.md
//
// Deliberately its own table, never written into Report/RelationshipDispute: the
// track's core invariant is that AI output must stay visibly, structurally distinct
// from verified/user-submitted/admin-reviewed facts, never silently blended in.
// AiModerationFlag queues a suspicious pattern for human review only — it never
// auto-actions anything (no auto-reject/auto-confirm) — see
// admin-ai-flag-service.ts#resolveAiFlag(). There is deliberately no numeric
// "confidence"/trust score on a person here, only a reason code + explanation that must
// cite concrete stored record ids (evidenceRefs) — the same "no opaque trust score,
// show evidence" rule as the rest of the product, applied to AI output too.
// ============================================================================

enum AiFlagTargetType {
  CREDENTIAL_CLAIM
  RELATIONSHIP
  ENDORSEMENT
  PROFESSIONAL_FEEDBACK
}

enum AiFlagStatus {
  PENDING
  REVIEWED_ACTIONED
  REVIEWED_DISMISSED
}

model AiModerationFlag {
  id                String           @id @default(cuid())
  targetType        AiFlagTargetType
  targetId          String
  // Which heuristic fired, e.g. "ENDORSEMENT_RING_SUSPECTED", "RAPID_CLAIM_BURST" —
  // see fraud-signal-service.ts for the fixed set of reason codes.
  reasonCode        String
  // Human-readable explanation — must only restate facts present in evidenceRefs below,
  // never a free-floating claim about the target's trustworthiness.
  explanation       String           @db.Text
  // Concrete stored record ids/fields the heuristic actually looked at, so the flag is
  // always traceable back to real evidence, never fabricated.
  evidenceRefs      Json
  status            AiFlagStatus     @default(PENDING)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNotes       String?          @db.Text
  createdAt         DateTime         @default(now())

  reviewedBy User? @relation("AiFlagReviewer", fields: [reviewedByUserId], references: [id])

  @@unique([targetType, targetId, reasonCode])
  @@index([status, targetType])
}
